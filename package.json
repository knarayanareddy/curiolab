{
  "name": "@curiolab/foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/walking-perception.ts && ./scripts/kotlin.sh run",
    "build": "tsc -p tsconfig.build.json && ./scripts/kotlin.sh build && corepack pnpm build:firetv",
    "lint": "eslint apps/firetv/src packages services scripts tests && prettier --check \"apps/firetv/src/**/*.ts\" \"packages/**/*.ts\" \"services/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"infra/**/*.json\" \"*.{json,mjs}\"",
    "typecheck": "tsc --noEmit && ./scripts/kotlin.sh typecheck",
    "test:unit": "vitest run tests/unit && ./scripts/kotlin.sh test",
    "test:contract": "vitest run tests/contract",
    "test:security": "vitest run tests/security && corepack pnpm audit --audit-level=moderate",
    "validate:content": "tsx scripts/validate-content.ts",
    "dev:firetv": "corepack pnpm build:browser-engine && ./scripts/kotlin.sh build && tsx scripts/firetv-simulator.ts",
    "build:firetv": "corepack pnpm build:browser-engine && vite build apps/firetv --mode pages",
    "smoke:firetv": "tsx scripts/firetv-smoke.ts",
    "build:backend": "tsx scripts/build-backends.ts",
    "test:infra": "vitest run tests/infra",
    "backend:test-session": "tsx scripts/provision-backend-test-session.ts",
    "build:browser-engine": "./scripts/build-browser-engine.sh",
    "dev:relay": "tsx services/session-relay/src/local-server.ts",
    "dev:content": "tsx services/content/src/local-server.ts",
    "record:demo": "tsx scripts/record-demo.ts",
    "verify:local": "tsx scripts/verify-local.ts",
    "smoke:pages": "tsx scripts/smoke-pages.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsdom": "26.1.0",
    "kotlin-compiler": "2.4.21",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.1156.0",
    "@aws-sdk/client-bedrock-runtime": "3.1156.0",
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0"
  }
}
