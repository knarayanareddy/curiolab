{
  "name": "@curiolab/foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx scripts/walking-perception.ts && ./scripts/kotlin.sh run",
    "build": "tsc -p tsconfig.build.json && ./scripts/kotlin.sh build",
    "lint": "eslint apps/firetv/src packages services scripts tests && prettier --check \"apps/firetv/src/**/*.ts\" \"packages/**/*.ts\" \"services/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\"",
    "typecheck": "tsc --noEmit && ./scripts/kotlin.sh typecheck",
    "test:unit": "vitest run tests/unit && ./scripts/kotlin.sh test",
    "test:contract": "vitest run tests/contract",
    "test:security": "vitest run tests/security && corepack pnpm audit --audit-level=moderate",
    "validate:content": "tsx scripts/validate-content.ts",
    "dev:firetv": "./scripts/kotlin.sh build && tsx scripts/firetv-simulator.ts",
    "build:firetv": "vite build apps/firetv",
    "smoke:firetv": "tsx scripts/firetv-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "jsdom": "26.1.0",
    "kotlin-compiler": "2.4.21",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
