# Safe local examples only. Owners: future pairing, relay, content, and hint services.
APP_ENV=local
AWS_REGION=us-east-1
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DEMO_MODE=fixture
DATA_RETENTION_DAYS=1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
BEDROCK_MODEL_ID=
PROMPT_SET_VERSION=hint_v1
CONTENT_CHANNEL=dev
LIVE_HINTS_ENABLED=false
# Native signing values must come from a protected local/CI secret store.
FIRETV_SIGNING_STORE_REFERENCE=
COMPANION_SIGNING_STORE_REFERENCE=
# Deployable backend: values are real stack outputs supplied only by an operator.
RELAY_TABLE=
RELAY_MANAGEMENT_ENDPOINT=
# LIVE_HINTS_ENABLED defaults false above; verify an available Converse text model before enabling.
# Optional LOCAL-only orchestration (set both, or neither). Compose supplies container URLs.
# RELAY_URL=http://127.0.0.1:8080
# CONTENT_URL=http://127.0.0.1:8081
# Optional browser capture/verification overrides; never put credentials in these URLs.
# DEMO_URL=http://127.0.0.1:5173/curiolab/
# PAGES_URL=http://127.0.0.1:4173/curiolab/
# CHROMIUM_EXECUTABLE_PATH=
