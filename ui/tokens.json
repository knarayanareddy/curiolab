{
  "meta": {
    "project": "CurioLab",
    "version": "1.0.0",
    "platforms": ["fire_tv_1080p", "android_companion"],
    "theme": "dark_storybook_laboratory",
    "contrast_pairs": {
      "text_on_canvas": { "foreground": "color.text", "background": "color.canvas", "minimum": 4.5 },
      "muted_on_canvas": { "foreground": "color.text_muted", "background": "color.canvas", "minimum": 4.5 },
      "text_on_surface": { "foreground": "color.text", "background": "color.surface", "minimum": 4.5 },
      "muted_on_surface": { "foreground": "color.text_muted", "background": "color.surface", "minimum": 4.5 },
      "primary_button": { "foreground": "color.on_primary", "background": "color.primary", "minimum": 4.5 },
      "accent_button": { "foreground": "color.on_accent", "background": "color.accent", "minimum": 4.5 },
      "focus_on_canvas": { "foreground": "color.focus", "background": "color.canvas", "minimum": 3.0 },
      "success_on_surface": { "foreground": "color.success", "background": "color.surface", "minimum": 4.5 },
      "warning_on_surface": { "foreground": "color.warning", "background": "color.surface", "minimum": 4.5 },
      "danger_on_surface": { "foreground": "color.danger", "background": "color.surface", "minimum": 4.5 }
    }
  },
  "color": {
    "canvas": { "$type": "color", "$value": "#10182B" },
    "surface": { "$type": "color", "$value": "#1B2942" },
    "surface_alt": { "$type": "color", "$value": "#263A56" },
    "text": { "$type": "color", "$value": "#F7F3E8" },
    "text_muted": { "$type": "color", "$value": "#C3CDD9" },
    "primary": { "$type": "color", "$value": "#F4B942" },
    "on_primary": { "$type": "color", "$value": "#172036" },
    "accent": { "$type": "color", "$value": "#69D2C2" },
    "on_accent": { "$type": "color", "$value": "#102A2A" },
    "border": { "$type": "color", "$value": "#71839B" },
    "focus": { "$type": "color", "$value": "#FFD66B" },
    "success": { "$type": "color", "$value": "#8BE0B2" },
    "warning": { "$type": "color", "$value": "#FFD166" },
    "danger": { "$type": "color", "$value": "#FF9B91" },
    "info": { "$type": "color", "$value": "#9CC8FF" }
  },
  "typography": {
    "display": { "$type": "fontFamily", "$value": "Fredoka, Trebuchet MS, sans-serif" },
    "body": { "$type": "fontFamily", "$value": "Atkinson Hyperlegible, Verdana, sans-serif" },
    "data": { "$type": "fontFamily", "$value": "Atkinson Hyperlegible, Verdana, sans-serif" },
    "size_display_tv": { "$type": "dimension", "$value": "64px" },
    "size_title_tv": { "$type": "dimension", "$value": "40px" },
    "size_body_tv": { "$type": "dimension", "$value": "30px" },
    "size_small_tv": { "$type": "dimension", "$value": "26px" },
    "size_body_companion": { "$type": "dimension", "$value": "16sp" },
    "line_body": { "$type": "number", "$value": 1.35 }
  },
  "spacing": {
    "unit_tv": { "$type": "dimension", "$value": "8px" },
    "safe_area_tv": { "$type": "dimension", "$value": "96px" },
    "section_tv": { "$type": "dimension", "$value": "40px" },
    "unit_companion": { "$type": "dimension", "$value": "4dp" }
  },
  "shape": {
    "radius_small": { "$type": "dimension", "$value": "10px" },
    "radius_large": { "$type": "dimension", "$value": "20px" },
    "target_tv": { "$type": "dimension", "$value": "72px" },
    "target_companion": { "$type": "dimension", "$value": "48dp" },
    "focus_width": { "$type": "dimension", "$value": "4px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "100ms" },
    "standard": { "$type": "duration", "$value": "200ms" },
    "scene_transition": { "$type": "duration", "$value": "450ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0.0, 0.0, 1.0] }
  },
  "layout": {
    "reference_tv": { "$type": "dimension", "$value": "1920x1080" },
    "caption_max": { "$type": "dimension", "$value": "46ch" },
    "companion_max": { "$type": "dimension", "$value": "480px" }
  }
}
